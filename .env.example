# كلمة مرور صفحة الإدخال - غيّرها لشيء قوي
ADMIN_PASSWORD=change_this_password

# مفتاح سري للجلسات - غيّره لأي نص عشوائي طويل
SESSION_SECRET=change_this_random_secret

# Railway يضيف هذا المتغير تلقائياً عند ربط خدمة Postgres بالمشروع
# لا تحتاج تكتبه يدوياً على Railway، فقط عند التجربة محلياً
DATABASE_URL=postgresql://user:pass@host:port/dbname

PORT=3000
